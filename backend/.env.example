# Arogyam Healthcare System - Environment Variables
# Copy this file to .env and fill in your actual values

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb+srv://your_username:your_password@cluster0.brknhko.mongodb.net/AROGYAM?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here_min_32_characters

# Frontend URL (for payment callbacks)
CLIENT_URL=http://localhost:5173

# Google OAuth (if using Google login)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CLOCK_SKEW_TOLERANCE=300000

# eSewa Payment Gateway Configuration
# IMPORTANT: Use TEST environment for development
ESEWA_BASE_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_MERCHANT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
ESEWA_PRODUCT_CODE=EPAYTEST

# eSewa Callback URLs
ESEWA_SUCCESS_URL=http://localhost:5000/api/payments/esewa/callback
ESEWA_FAILURE_URL=http://localhost:5000/api/payments/esewa/failure

# Email Configuration (for notifications)
