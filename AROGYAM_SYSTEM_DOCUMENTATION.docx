      headers: { Authorization: `Bearer ${token}` }
    }),
    fetch(`http://localhost:5000/api/soap/patient/${patientId}`, {
      headers: { Authorization: `Bearer ${token}` }
    })
  ]);
  
  // Process both data types
  if (appointmentsData.success) {
    setPatientHistory(appointmentsData.patient);
  }
  if (soapNotesData.success) {
    setPatientSOAPNotes(soapNotesData.soapNotes || []);
  }
};

